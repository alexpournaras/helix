{
  "name": "helix",
  "version": "0.1.0",
  "private": true,
  "description": "Helix: admin panel for a biomedical research platform (React + FastAPI).",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexpournaras/helix.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && node scripts/py.mjs -m venv backend/.venv && node scripts/py.mjs -m pip install -r backend/requirements.txt",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "node scripts/py.mjs backend/run.py",
    "build": "vite build",
    "start": "vite build && node scripts/py.mjs backend/run.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sass-embedded": "^1.83.0",
    "vite": "^6.0.0"
  }
}
