# Copy to backend/.env and fill in what you use. Never commit the real .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Only for Ollama cloud models (https://ollama.com). Local Ollama needs no key.
OLLAMA_API_KEY=
# Optional, free: raises the PubMed and PubMed Central rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
# Research (Investigations). Use an OpenAI project WITHOUT data sharing for real health text.
# Free, required for OpenAlex search (M2).
OPENALEX_API_KEY=
# Optional: higher Semantic Scholar rate limit (M2).
SEMANTIC_SCHOLAR_API_KEY=
# A contact email of your choice; Unpaywall requires one to look up legal open-access PDFs (M2).
UNPAYWALL_EMAIL=
